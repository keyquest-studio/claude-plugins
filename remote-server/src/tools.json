[
 {
  "name": "list_recipes",
  "description": "List original ForkFlip recipes using optional filters and pagination. Diet labels are not allergy guarantees.",
  "inputSchema": {
   "properties": {
    "language": {
     "default": "en",
     "enum": [
      "he",
      "en",
      "ru",
      "ar",
      "fr",
      "de",
      "es"
     ],
     "title": "Language",
     "type": "string"
    },
    "meal": {
     "anyOf": [
      {
       "enum": [
        "breakfast",
        "lunch",
        "dinner",
        "dessert"
       ],
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Meal"
    },
    "diet": {
     "anyOf": [
      {
       "enum": [
        "meat",
        "dairy",
        "vegetarian",
        "vegan",
        "keto"
       ],
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Diet"
    },
    "kosher_only": {
     "default": false,
     "title": "Kosher Only",
     "type": "boolean"
    },
    "max_minutes": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Max Minutes"
    },
    "cuisine": {
     "anyOf": [
      {
       "enum": [
        "mediterranean",
        "middleEastern",
        "italian",
        "asian",
        "thai",
        "mexican",
        "indian",
        "american",
        "french"
       ],
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Cuisine"
    },
    "offset": {
     "default": 0,
     "title": "Offset",
     "type": "integer"
    },
    "limit": {
     "default": 10,
     "title": "Limit",
     "type": "integer"
    }
   },
   "title": "list_recipesArguments",
   "type": "object"
  },
